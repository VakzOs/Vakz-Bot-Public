{
  "name": "vakz-bot",
  "version": "0.1.0",
  "description": "Bot Discord multi-serveurs, modulaire et auto-hébergé — alternative libre et gratuite à DraftBot.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:prod": "node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit",
    "check:backup": "tsx scripts/check-backup.ts",
    "check:acces": "tsx scripts/check-acces.ts",
    "check:invitations": "tsx scripts/check-invitations.ts",
    "check:lint": "tsx scripts/check-lint.ts",
    "check:updater": "bash scripts/check-updater.sh",
    "check:sync": "bash scripts/check-sync-public.sh",
    "commandes:check": "tsx scripts/verifier-commandes.ts",
    "reglages:check": "tsx scripts/verifier-reglages.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "i18n:check": "node scripts/verifier-i18n.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "discord.js": "^14.16.3",
    "dotenv": "^17.4.2",
    "lavalink-client": "^2.10.3",
    "node-cron": "^4.6.0",
    "node-emoji": "^2.2.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.83.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
