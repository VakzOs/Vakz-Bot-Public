{
  "name": "vakz-bot",
  "version": "0.1.0",
  "description": "Bot Discord multi-serveurs, modulaire et auto-hébergé — alternative libre et gratuite à DraftBot.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:prod": "node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.1",
    "@prisma/client": "^6.2.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "lavalink-client": "^2.10.3",
    "node-cron": "^3.0.3",
    "node-emoji": "^2.2.0",
    "pino": "^9.6.0",
    "prisma": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
