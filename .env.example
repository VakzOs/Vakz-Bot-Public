# =============================================================================
# Vakz-Bot — Exemple de configuration
# -----------------------------------------------------------------------------
# Copiez ce fichier en `.env` puis remplissez les valeurs :
#     cp .env.example .env
#
# ⚠️  NE JAMAIS committer le fichier `.env` (il est ignoré par Git).
#     Le token Discord est un secret : s'il fuite, régénérez-le immédiatement
#     sur https://discord.com/developers/applications
# =============================================================================

# --- Discord (REQUIS) --------------------------------------------------------
# Token du bot (Developer Portal > votre application > Bot > Reset Token)
DISCORD_TOKEN=
# Identifiant (snowflake) de l'application (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=

# --- Discord (OPTIONNEL) -----------------------------------------------------
# ID d'un serveur de développement. En général, LAISSEZ VIDE : au démarrage, le
# bot déploie alors les commandes serveur par serveur sur tous les serveurs où il
# est présent — c'est INSTANTANÉ (le déploiement global, lui, met jusqu'à ~1h à se
# propager). Ne le remplissez que pour cibler un unique serveur de test.
DISCORD_GUILD_ID=

# Déployer automatiquement les slash commands au démarrage du bot ? (true/false).
# Recommandé en self-host : les nouvelles commandes apparaissent instantanément
# sur chaque serveur, sans lancer `deploy` à la main ni attendre la propagation.
DEPLOY_COMMANDS_ON_START=true

# --- Base de données (REQUIS) ------------------------------------------------
# SQLite en local. En Docker, ce chemin pointe vers le volume persistant.
#   Local  : file:./dev.db
#   Docker : file:/app/data/prod.db
DATABASE_URL="file:./dev.db"

# --- Divers (OPTIONNEL) ------------------------------------------------------
# Niveau de logs pino : trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Environnement : development | production
NODE_ENV=development
# Fuseau horaire utilisé par le scheduler (node-cron)
TZ=Europe/Paris

# --- Intégrations tierces (OPTIONNEL) ---------------------------------------
# Laissez vide pour désactiver automatiquement la feature correspondante.
# Module « Alertes Twitch/YouTube » : les alertes Twitch nécessitent une app
# créée sur https://dev.twitch.tv/console/apps (Client ID + Client Secret).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube fonctionne sans clé (flux RSS). Renseigner une clé (API Data v3,
# console.cloud.google.com) rend les alertes de nouvelles vidéos plus réactives.
YOUTUBE_API_KEY=
# Résolveur Cloudflare (FlareSolverr) pour les sources protégées (Dealabs). En
# Docker Compose, le service `flaresolverr` est fourni et cette variable est déjà
# renseignée. Laisser vide désactive uniquement Dealabs (les autres sources OK).
FLARESOLVERR_URL=

# --- Mise à jour depuis le bot (commande /maj, optionnel) ---
# ID Discord du propriétaire autorisé à lancer /maj (clic droit sur ton profil
# → Copier l'identifiant, mode développeur activé). Vide = commande désactivée.
BOT_OWNER_ID=
# Dossier partagé avec l'updater hôte (doit correspondre au volume monté).
# En Docker, le volume data est monté sur /app/data.
DEPLOY_DIR=/app/data
# Branches proposées dans le sélecteur de /maj (séparées par des virgules).
# Ex. pour aussi déployer une branche de test :
#   DEPLOY_BRANCHES=main,claude/optimistic-goodall-wcxypa
DEPLOY_BRANCHES=main

# --- API web (dashboard) ---
# Token secret partage avec le site Vercel. Vide = API web desactivee.
# Genere-le : openssl rand -hex 32  (meme valeur cote Vercel : BOT_API_TOKEN)
WEB_API_TOKEN=
# Port d'ecoute de l'API web.
# ⚠️  SECURITE : ce token donne acces a l'administration de TOUS les serveurs.
#     Ne PAS exposer ce port en clair sur Internet : le header Authorization
#     (Bearer <token>) voyagerait en clair et pourrait etre intercepte.
#     Chemin RECOMMANDE : garder ce port sur localhost/reseau prive et publier
#     l'API UNIQUEMENT via HTTPS (bloc « HTTPS » ci-dessous, ou un tunnel
#     Cloudflare). Cote Vercel, BOT_API_URL doit alors etre en https://.
WEB_API_PORT=3210

# --- HTTPS (reverse-proxy Caddy, RECOMMANDE) ---
# Chiffre le token entre Vercel et le VPS. Fortement conseille des que l'API est
# joignable depuis Internet. Renseigne ces deux variables, fais pointer un
# sous-domaine (DNS A) vers le VPS, ouvre 80+443, puis lance :
#     docker compose --profile proxy up -d
# Cote Vercel, BOT_API_URL devient alors https://<CADDY_DOMAIN>.
# (Alternative sans ouvrir de ports : un tunnel Cloudflare vers WEB_API_PORT.)
CADDY_DOMAIN=
CADDY_EMAIL=

# --- Uptime Kuma (heartbeat, optionnel) ---
# URL de push d'un moniteur « Push » Uptime Kuma, SANS les parametres de requete.
# Vide = desactive. Le bot ping ce moniteur toutes les UPTIME_PUSH_INTERVAL sec.
UPTIME_PUSH_URL=
UPTIME_PUSH_INTERVAL=30

# --- Intent Presence (privilegie, optionnel) ---
# Active l'intent GuildPresences : requis pour detecter en temps reel les
# changements de PROFIL GLOBAL (nom / photo de profil) des membres dans la
# surveillance (module Commandes d'informations). Active AUSSI « Presence
# Intent » dans le Developer Portal (Bot), sinon le bot refuse de demarrer.
PRESENCE_INTENT=false
